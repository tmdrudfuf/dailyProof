{
  "expo": {
    "name": "DailyProof",
    "slug": "dailyproof",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F2EA"
    },
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DailyProof to use your camera to capture proof photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C9FF4A",
          "defaultChannel": "dailyproof-reminders",
          "sounds": []
        }
      ],
      "expo-font"
    ],
    "ios": {
      "bundleIdentifier": "com.yourcompany.dailyproof",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow DailyProof to use your camera to capture proof photos.",
        "NSUserNotificationUsageDescription": "Allow DailyProof to send goal reminder notifications."
      },
      "supportsTablet": true
    },
    "android": {
      "package": "com.yourcompany.dailyproof",
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e4b2578f-8297-4e50-921d-3664691b972f"
      }
    }
  }
}
