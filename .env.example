# Firebase Console -> Project settings -> Your apps -> Web app
# Copy this file to .env.local and replace each placeholder.
# EXPO_PUBLIC_* values are bundled into the client and are not secrets.
# Never put Firebase service-account credentials in this file.

EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# MVP-only client placeholder.
# EXPO_PUBLIC_* values are visible in the app bundle; use a backend proxy before production.
EXPO_PUBLIC_OPENAI_API_KEY=your-openai-api-key
EXPO_PUBLIC_OPENAI_VISION_MODEL=gpt-5.5
